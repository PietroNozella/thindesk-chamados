          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test(\"Dados resolvidos preservados\", function () { const anterior = JSON.parse(pm.environment.get(\"chamadoResolvido\")); pm.expect(pm.response.json()).to.deep.eql(anterior); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "10 — Recusar resolução por solicitante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados/{{chamadoId}}/resolver",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solucao\": \"Tentativa sem perfil técnico.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
