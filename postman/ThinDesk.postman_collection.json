{
  "info": {
    "name": "ThinDesk — Chamados técnicos",
    "description": "Testes dos endpoints e das regras de chamados. Execute o Fluxo principal em ordem. As credenciais ficam no ambiente local ignorado pelo Git.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{usuario}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{senha}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Fluxo principal",
      "item": [
        {
          "name": "01 — Identificar solicitante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/autenticacao",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const dados = pm.response.json(); pm.environment.set(\"usuarioId\", dados.usuario); pm.test(\"Perfil solicitante\", () => pm.expect(dados.perfil).to.eql(\"SOLICITANTE\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Abrir chamado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Impressora sem conexão\",\n  \"descricao\": \"A impressora do setor não aparece na rede.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const chamado = pm.response.json(); pm.environment.set(\"chamadoId\", chamado.id); pm.test(\"Campos automáticos\", function () { pm.expect(chamado.status).to.eql(\"ABERTO\"); pm.expect(chamado.usuario).to.eql(pm.environment.get(\"usuarioId\")); pm.expect(chamado.dataAbertura).to.be.a(\"string\"); pm.expect(chamado.dataResolucao).to.eql(null); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Listar chamados do solicitante",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados/usuario/{{usuarioId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test(\"Chamado aparece na lista\", () => pm.expect(pm.response.json().map(c => c.id)).to.include(pm.environment.get(\"chamadoId\"))); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — Consultar detalhes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados/{{chamadoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test(\"Chamado aberto\", () => pm.expect(pm.response.json().status).to.eql(\"ABERTO\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — Identificar técnico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/autenticacao",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{tecnico}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{senhaTecnico}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test(\"Perfil técnico\", () => pm.expect(pm.response.json().perfil).to.eql(\"TECNICO\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — Resolver como técnico",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados/{{chamadoId}}/resolver",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{tecnico}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{senhaTecnico}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solucao\": \"Configuração de rede corrigida e impressão de teste realizada.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const chamado = pm.response.json(); pm.environment.set(\"chamadoResolvido\", JSON.stringify(chamado)); pm.test(\"Resolução registrada\", function () { pm.expect(chamado.status).to.eql(\"RESOLVIDO\"); pm.expect(chamado.tecnico).to.eql(pm.environment.get(\"tecnico\")); pm.expect(chamado.dataResolucao).to.be.a(\"string\"); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "07 — Acompanhar resolução e persistência",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chamados/{{chamadoId}}",
            "description": "Repita esta requisição após reiniciar a aplicação e o MongoDB, mantendo o volume."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.test(\"Dados resolvidos preservados\", function () { const anterior = JSON.parse(pm.environment.get(\"chamadoResolvido\")); pm.expect(pm.response.json()).to.deep.eql(anterior); }); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validações e permissões",
      "item": [
        {
          "name": "08 — Recusar nova resolução",
          "request": {
            "method": "PUT",
