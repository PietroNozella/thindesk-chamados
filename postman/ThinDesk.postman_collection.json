              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Teste\",\n  \"descricao\": \"Tentativa de definir status.\",\n  \"status\": \"RESOLVIDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
