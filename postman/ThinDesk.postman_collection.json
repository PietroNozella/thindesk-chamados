            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{tecnico}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{senhaTecnico}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solucao\": \"Tentativa de substituir a solução.\"\n}",
